# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# Chrome extension build output
/extension/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep example files (no secrets) in git
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

scaffold.sh
# Local session write-ups (not for the repo)
/CHANGES.md
/INTERVIEW_UPDATE.md
